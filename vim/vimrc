""" PLUGIN MANAGER (VIM-PLUG) {{{

let s:plug_path = expand('~/.vim/autoload/plug.vim')
let s:plug_url = 'https://raw.githubusercontent.com/junegunn/vim-plug/master/plug.vim'
let s:plugins_ready = 0
let s:missing_plugins = []

if !filereadable(s:plug_path)
    let s:plug_dir = fnamemodify(s:plug_path, ':h')
    let s:plug_tmp = s:plug_path . '.tmp-' . getpid()
    if executable('curl') && (isdirectory(s:plug_dir) || mkdir(s:plug_dir, 'p'))
        call delete(s:plug_tmp)
        call system('curl -fL --silent --show-error -o ' . shellescape(s:plug_tmp) . ' ' . shellescape(s:plug_url))
        if v:shell_error == 0 && filereadable(s:plug_tmp) && getfsize(s:plug_tmp) > 0 && rename(s:plug_tmp, s:plug_path) == 0
            echom '[dotfiles] vim-plug installed. Run :PlugInstall, wait for it to finish, then restart Vim.'
        else
            call delete(s:plug_tmp)
            echom '[dotfiles] Could not install vim-plug at ' . s:plug_path . '. Retry when online, or run: curl -fLo ' . shellescape(s:plug_path) . ' --create-dirs ' . s:plug_url . ' ; then restart Vim.'
        endif
    else
        echom '[dotfiles] vim-plug is missing and curl or its destination is unavailable. Install it at ' . s:plug_path . ' and restart Vim.'
    endif
endif

if filereadable(s:plug_path) && executable('git')
    call plug#begin('~/.vim/plugged')

" Colorschemes: Additional colorschemes that can be used
Plug 'morhetz/gruvbox'
Plug 'romainl/flattened'
Plug 'romainl/apprentice'
Plug 'KeitaNakamura/neodark.vim'
Plug 'sjl/badwolf'
Plug 'joshdick/onedark.vim'

" Syntax: Additional syntaxes that can be used
Plug 'tpope/vim-git', { 'for': 'git' }
Plug 'cakebaker/scss-syntax.vim', { 'for': 'scss' }
Plug 'rust-lang/rust.vim'

" FZF Vim: Fuzzy file openener vim extension
if executable('fzf')
    Plug 'junegunn/fzf'
    Plug 'junegunn/fzf.vim'
endif

" Tmux-Navigator: Allows tmux keyboard shortcuts to be used within vim
Plug 'christoomey/vim-tmux-navigator'

" Git: Plugins for git usage
Plug 'tpope/vim-fugitive'
Plug 'airblade/vim-gitgutter'

" Bbye: Buffer Bye for Vim - Allows closing buffers without screwing up the window layout
Plug 'moll/vim-bbye', {'on': 'Bdelete'}

" surround.vim: quoting/parenthesizing made simple
Plug 'tpope/vim-surround'

" repeat.vim: Enable repeating supported plugin maps with "."
Plug 'tpope/vim-repeat'

" unimpaired.vim: Pair mapping for vim lists
Plug 'tpope/vim-unimpaired'

" vim-cool: Disable hlsearch when you are done searching
Plug 'romainl/vim-cool'

" ReplaceWithRegister: Replace text with the contents of a register
Plug 'vim-scripts/ReplaceWithRegister'

" vim-argwrap: Wrap and unwrap function arguments, lists and dictionaries
Plug 'FooSoft/vim-argwrap'

" vim-commentary: Commenting plugins
Plug 'tpope/vim-commentary'

" Auto Pairs: Provides automatic matching brackets / quotes
Plug 'jiangmiao/auto-pairs'

    call plug#end()

    for [s:plugin_name, s:plugin] in items(g:plugs)
        if !isdirectory(s:plugin.dir)
            call add(s:missing_plugins, s:plugin_name)
        endif
    endfor

    let s:plugins_ready = empty(s:missing_plugins)
    if !s:plugins_ready
        echom '[dotfiles] Missing Vim plugins: ' . join(s:missing_plugins, ', ') . '. Run :PlugInstall, wait for completion, then restart Vim.'
    endif
elseif filereadable(s:plug_path)
    echom '[dotfiles] Git is required by vim-plug. Install Git, then restart Vim.'
endif

""" END PLUGIN MANAGER }}}
""" LOAD MINIMAL VIMRC {{{

" Follow the ~/.vimrc symlink into the repository and load vimrc.minimal beside this file
exec "source " . fnameescape(fnamemodify(resolve(expand('<sfile>:p')), ':h') . "/vimrc.minimal")

""" END LOAD MINIMAL VIMRC }}}
""" PLUGIN INTEGRATION {{{

" FZF Integration: Add shortcuts for FZF usage
if executable('fd')
    let $FZF_DEFAULT_COMMAND = 'fd --type f'
elseif executable('fdfind')
    let $FZF_DEFAULT_COMMAND = 'fdfind --type f'
elseif executable('rg')
    let $FZF_DEFAULT_COMMAND = 'rg --files'
endif

if s:plugins_ready
if executable('fzf')
    command! LocalFiles execute 'Files' expand('%:h')

    nnoremap <silent> ,b :Buffers<cr>
    nnoremap <silent> ,gf :GFiles<cr>
    nnoremap <silent> ,f :Files<cr>
    nnoremap <silent> ,F :LocalFiles<cr>
    nnoremap <silent> ,t :Tags<cr>
endif

if executable('fzf') && executable('rg')
    nnoremap <silent> ,/ :execute 'Rg ' . input('Rg/')<cr>
endif

" vim-argwrap
nnoremap <silent> ,A :ArgWrap<cr>

" Bbye integration: Close the current buffer
cabbrev bd Bdelete
nnoremap ,c :Bdelete<cr>

" Vim-surround integration: Allow the usage of * as a surround character for multiline C-style comments
let g:surround_{char2nr("*")} = "/* \r */"

" Git-Gutter integration
let g:gitgutter_map_keys = 0
endif

""" END PLUGIN INTEGRATION }}}
