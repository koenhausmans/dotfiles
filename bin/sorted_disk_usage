#!/usr/bin/env bash
set -euo pipefail

block_size=MiB
quiet=false
root_command=()
additional_options=()

show_help() {
    cat <<'EOF'
usage: sorted_disk_usage [--size=SIZE] [--root] [--quiet] [du options or paths]

arguments:
  -s SIZE|--size=SIZE  Sets the size unit: k/kb/kib, m/mb/mib, g/gb/gib
  -r|--root            Executes the command as root
  -q|--quiet           Ignores du error output
EOF
}

extend_size_abbreviation() {
    case ${1,,} in
        k|kb|kib) printf 'KiB\n' ;;
        m|mb|mib) printf 'MiB\n' ;;
        g|gb|gib) printf 'GiB\n' ;;
        *) printf 'Invalid size provided: %s\n' "$1" >&2; return 2 ;;
    esac
}

while (( $# > 0 )); do
    case $1 in
        -s|--size)
            if (( $# < 2 )); then
                printf 'Missing size after %s\n' "$1" >&2
                exit 2
            fi
            block_size=$(extend_size_abbreviation "$2")
            shift 2
            ;;
        -s=*|--size=*)
            block_size=$(extend_size_abbreviation "${1#*=}")
            shift
            ;;
        -r|--root) root_command=(sudo); shift ;;
        -q|--quiet) quiet=true; shift ;;
        -h|--help) show_help; exit 0 ;;
        --) additional_options+=("$@"); break ;;
        *) additional_options+=("$1"); shift ;;
    esac
done

sort_options=(-h)
skip_argument=false
for option in "${additional_options[@]}"; do
    if $skip_argument; then
        skip_argument=false
        continue
    fi
    case $option in
        --) break ;;
        --nu|--nul|--null) sort_options+=(-z) ;;
        --*)
            # GNU du also accepts unambiguous long-option abbreviations.
            for argument_option in --block-size --max-depth --threshold --exclude --exclude-from --files0-from; do
                if [[ $argument_option == "$option"* ]]; then
                    skip_argument=true
                    break
                fi
            done
            ;;
        -*)
            # du permits clustered short options, such as -a0. These options
            # take arguments, so their remaining characters are not flags.
            flags=${option#-}
            while [[ -n $flags ]]; do
                case ${flags:0:1} in
                    0) sort_options+=(-z); break ;;
                    B|d|t|X)
                        [[ ${#flags} -gt 1 ]] || skip_argument=true
                        break ;;
                esac
                flags=${flags:1}
            done
            ;;
    esac
done

if $quiet; then
    "${root_command[@]}" du --block-size="$block_size" --max-depth=1 "${additional_options[@]}" 2>/dev/null | sort "${sort_options[@]}"
else
    "${root_command[@]}" du --block-size="$block_size" --max-depth=1 "${additional_options[@]}" | sort "${sort_options[@]}"
fi
