#!/usr/bin/env bash

set -euo pipefail

source "$(dirname "$(readlink -f "$0")")/../lib/git.sh"

usage() {
    printf 'Usage: %s [-b base] [-c context] [-g] [git log args...]\n' "$(basename "$0")" >&2
    exit 1
}

Base=
Context=3
Graph=()
Args=()
while (( $# )); do
    case $1 in
        -b|--base) (( $# >= 2 )) || usage; Base=$2; shift 2 ;;
        -c|--context) (( $# >= 2 )) || usage; Context=$2; shift 2 ;;
        -g|--graph) Graph=(--graph); shift ;;
        -h|--help) usage ;;
        *) Args+=("$1"); shift ;;
    esac
done

if ! git rev-parse --show-toplevel >/dev/null 2>&1; then
    printf 'No git root directory found\n' >&2
    exit 1
fi

if [[ -z "$Base" ]]; then
    Base=$(git_target 2>/dev/null || true)
fi

Current=$(git symbolic-ref --quiet --short HEAD || true)
Upstream=
if [[ -n "$Current" ]]; then
    Upstream=$(git for-each-ref --format='%(upstream:short)' "refs/heads/$Current")
    if [[ -n "$Upstream" ]] && ! git rev-parse --verify --quiet '@{u}' >/dev/null; then
        Upstream=
    fi
fi

Fork=
if [[ -n "$Base" && -n "$Current" && "$Current" != "$Base" ]]; then
    Fork=$(git merge-base --fork-point "$Base" HEAD 2>/dev/null \
        || git merge-base "$Base" HEAD 2>/dev/null || true)
fi

Unpushed=
if [[ -n "$Upstream" ]]; then
    Unpushed=$(git rev-list '@{u}..HEAD' | tr '\n' ' ')
fi

Yellow=$'\e[33m' Green=$'\e[32m' Blue=$'\e[34m' Magenta=$'\e[35m' Red=$'\e[31m' Dim=$'\e[2m' Reset=$'\e[0m'

header() {
    if [[ -z "$Current" ]]; then
        printf '%s(detached HEAD)%s\n' "$Dim" "$Reset"
        return
    fi
    local Line="$Green$Current$Reset" Ahead Behind Count
    if [[ -n "$Upstream" ]]; then
        read -r Ahead Behind < <(git rev-list --left-right --count 'HEAD...@{u}')
        Line+=" → $Blue$Upstream$Reset"
        (( Ahead )) && Line+=" $Green↑$Ahead$Reset"
        (( Behind )) && Line+=" $Red↓$Behind$Reset"
        (( Ahead + Behind )) || Line+=" ${Dim}(in sync)$Reset"
    else
        Line+=" ${Dim}(no upstream)$Reset"
    fi
    if [[ -n "$Fork" ]]; then
        Count=$(git rev-list --count "$Fork..HEAD")
        Line+="  $Dim·$Reset  forked from $Magenta$Base$Reset @ $Yellow$(git rev-parse --short "$Fork")$Reset"
        Line+=" $Dim($(git log -1 --format=%ad --date=short "$Fork"), $Count commits ago)$Reset"
    fi
    printf '%s\n' "$Line"
}

Range=()
if (( ${#Args[@]} == 0 )) && [[ -n "$Fork" ]]; then
    Range=(HEAD)
    if Stop=$(git rev-parse --verify --quiet "$Fork~$Context"); then
        Range+=("^$Stop")
    fi
fi

Columns=
if [[ -t 1 ]]; then
    Columns=$(stty size </dev/tty 2>/dev/null | cut -d' ' -f2 || true)
    Pager=(${GIT_PAGER:-less -FRX})
else
    Pager=(cat)
fi
Columns=${Columns:-${COLUMNS:-160}}

Format='%x1f%H%x1f%h%x1f%D%x1f%s%x1f%ad%x1f%ae'

{
    header
    git log --color=always --date=short "${Graph[@]}" --pretty=format:"$Format" \
        "${Range[@]}" "${Args[@]}"
    printf '\n'
} | awk -F '\037' -v columns="$Columns" -v fork="$Fork" -v unpushed="$Unpushed" '
    function visible(s) { gsub(/\033\[[0-9;]*m/, "", s); return length(s) }
    function cut(s, w) { return length(s) <= w ? s : (w < 3 ? substr(s, 1, w > 0 ? w : 0) : substr(s, 1, w - 2) "…") }
    function paint(refs,    n, i, r, out, color) {
        n = split(refs, list, ", ")
        out = ""
        for (i = 1; i <= n; i++) {
            r = list[i]
            if (r ~ /^HEAD/) color = "\033[1;36m"
            else if (r ~ /^tag: /) color = "\033[1;33m"
            else if (r ~ /\//) color = "\033[1;31m"
            else color = "\033[1;32m"
            out = out (i > 1 ? "\033[33m, " : "") color r
        }
        return "\033[33m(" out "\033[33m)\033[0m "
    }
    BEGIN {
        n = split(unpushed, list, " ")
        for (i = 1; i <= n; i++) up[list[i]] = 1
        reset = "\033[0m"
    }
    NR == 1 {
        if (visible($0) >= columns) sub(/ \033\[2m\([^)]*\)\033\[0m$/, "")
        if (visible($0) >= columns) { gsub(/\033\[[0-9;]*m/, ""); $0 = cut($0, columns - 1) }
        print
        next
    }
    NF < 7 { print "  " $0; next }
    {
        prefix = $1
        mark = ($2 == fork) ? "\033[35m◆" reset : ($2 in up) ? "\033[32m↑" reset : " "
        email = cut($7, 22)
        tail = sprintf("  %s %-24s", $6, "<" email ">")
        room = columns - visible(prefix) - 2 - length($3) - 1 - length(tail)
        refs = $4
        if (refs != "" && length(refs) + 3 > room / 2) refs = cut(refs, int(room / 2) - 3)
        refsWidth = refs == "" ? 0 : length(refs) + 3
        subject = cut($5, room - refsWidth)
        pad = room - refsWidth - length(subject)
        printf "%s%s \033[33m%s%s %s%s%*s  \033[32m%s \033[34m%s%s\n", prefix, mark, $3, reset,
            (refs == "" ? "" : paint(refs)), subject, (pad > 0 ? pad : 0), "",
            $6, "<" email ">", reset
    }' | "${Pager[@]}"
