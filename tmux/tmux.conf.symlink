
###
### tmux-sensible settings
###
### Source: https://github.com/tmux-plugins/tmux-sensible/blob/master/sensible.tmux
###

# Address vim mode switching delay (http://superuser.com/a/252717/65504)
set -s escape-time 50
# Bigger history, increase scrollback buffer size
set -g history-limit 50000
# Tmux messages are displayed for 4 seconds
set -g display-time 4000
# Refresh 'status-left' and 'status-right' more often
set -g status-interval 5
# Default termtype. If the rcfile sets $TERM, that overrides this value.
# set -g default-terminal "screen-256color"
set -s default-terminal "screen-256color"
# emacs key bindings in tmux command prompt (prefix + :) are better than
# vi keys, even for vim users
set -g status-keys emacs
# Use vi keybindings in copy and choice modes
setw -g mode-keys vi
# focus events enabled for terminals that support them
set -g focus-events on
# Super useful when using "grouped sessions" and multi-monitor setup
setw -g aggressive-resize on
# set first window to index 1 (not 0) to map more to the keyboard layout...
set -g base-index 1
setw -g pane-base-index 1
set -g renumber-windows on

###
### Change the default shell
###
set -g default-command "$SHELL"
set -g default-shell "$SHELL"

# Ring the bell if any background window rang a bell
set -g bell-action any

###
### Copying to system clipboard (via OSC 52)
###
# Send copies to the system clipboard via OSC 52
set -s set-clipboard on
# Enable mouse support
set -g mouse on
# Tell tmux your outer terminal supports it (needed if its terminfo lacks the Ms capability)
set -as terminal-features ',xterm*:clipboard'
# Vi-style copy mode bindings
bind -T copy-mode-vi v send -X begin-selection
bind -T copy-mode-vi C-v send -X rectangle-toggle
bind -T copy-mode-vi y send -X copy-selection-and-cancel
# Do not clear selection when releasing mouse drag
bind -T copy-mode-vi MouseDragEnd1Pane send -X copy-selection-no-clear

###
### Change the default prefix key for Tmux
###

# Screen like binding (remap prefix to Control + a)
set -g prefix C-a
# Unbind obsolete default binding
unbind C-b
# Pressing `prefix + prefix` sends <prefix> to the shell
bind C-a send-prefix
# `Ctrl-a + a` switches between alternate windows.
bind a last-window
# Quick pane cycling
bind A select-pane -t :.+

###
### Window Shortcuts
###
bind C-p previous-window
bind C-n next-window

# Open new window in same directory as current pane
bind c new-window -c "#{pane_current_path}"

###
### Split Shortcuts
###
bind  v split-window -h -p 50 -c "#{pane_current_path}"
bind ^V split-window -h -p 50 -c "#{pane_current_path}"
bind  s split-window -v -p 50 -c "#{pane_current_path}"
bind ^S split-window -v -p 50 -c "#{pane_current_path}"
bind  | split-window -h -c '#{pane_current_path}'
bind  - split-window -v -c '#{pane_current_path}'
bind  _ split-window -v -c '#{pane_current_path}'

###
### Pane switch shortcuts
###
### Pane resize in all four directions using vi bindings.
###
### `Prefix E` is evenly space
### `Prefix z` is zoom
###
bind -r H resize-pane -L 5
bind -r J resize-pane -D 5
bind -r K resize-pane -U 5
bind -r L resize-pane -R 5

bind -r h resize-pane -L 1
bind -r j resize-pane -D 1
bind -r k resize-pane -U 1
bind -r l resize-pane -R 1

# Smart pane switching with awareness of vim splits.
# Source: https://github.com/christoomey/vim-tmux-navigator
is_vim="ps -o state= -o comm= -t '#{pane_tty}' \
    | grep -iqE '^[^TXZ ]+ +(\\S+\\/)?g?(view|n?vim?x?)(diff)?$'"
bind -n C-h if-shell "$is_vim" "send-keys C-h" "select-pane -L"
bind -n C-j if-shell "$is_vim" "send-keys C-j" "select-pane -D"
bind -n C-k if-shell "$is_vim" "send-keys C-k" "select-pane -U"
bind -n C-l if-shell "$is_vim" "send-keys C-l" "select-pane -R"

###
### Set default tmux theme
### Source: https://gist.github.com/gchiam/4606522f513cc64b79ce
###
set  -g status-justify centre
set  -g status-style 'fg=colour223,bg=colour237'
set  -g pane-border-style 'fg=colour238'
set  -g pane-active-border-style 'fg=colour109'
set  -g pane-border-lines heavy
set  -g message-style 'fg=colour237,bg=colour109'
set  -g message-command-style 'fg=colour237,bg=colour248'
set  -g mode-style 'fg=colour237,bg=colour214'
set  -g clock-mode-colour colour109

setw -g window-status-style 'fg=colour223,bg=colour239'
setw -g window-status-current-style 'fg=colour237,bg=colour109'
setw -g window-status-activity-style 'fg=colour237,bg=colour208'
setw -g window-status-bell-style 'fg=colour237,bg=colour167'
setw -g window-status-separator ' '

set  -g status-left '#[fg=colour237,bg=colour248] #[bold]#S#[nobold] │ #h '
set  -g status-left-length 40
set  -g status-right '#{E:@mode_indicator}'
setw -g window-status-format " #I#{?window_flags,#{window_flags}, } │ #W "
setw -g window-status-current-format " #I#{?window_flags,#{window_flags}, } │ #[bold]#W#[nobold] "

###
### tmux-mode-indicator
###
### Based on: https://github.com/MunifTanjim/tmux-mode-indicator
###
# Mode indicator in gruvbox colours: suspended grey, prefix blue, copy yellow, sync red, normal green
set  -g @mode_style "#{?#{==:#{client_key_table},suspended},#[bg=colour245 fg=colour237],#{?client_prefix,#[bg=colour109 fg=colour237],#{?pane_in_mode,#[bg=colour214 fg=colour237],#{?pane_synchronized,#[bg=colour167 fg=colour237],#[bg=colour142 fg=colour237]}}}}"
set -g @mode_prompt "#{?#{==:#{client_key_table},suspended}, ---- ,#{?client_prefix, WAIT ,#{?pane_in_mode, COPY ,#{?pane_synchronized, SYNC , TMUX }}}}"
set -g @mode_indicator '#[default]#{E:@mode_style}#{E:@mode_prompt}#[default]'

###
### tmux-suspend
###
### Based on: https://github.com/MunifTanjim/tmux-suspend/blob/main/suspend.tmux
###
bind -T root F12 {
  set -q prefix none
  set key-table suspended
  if -F '#{pane_in_mode}' { send -X cancel }
  if -F '#{pane_synchronized}' { set synchronize-panes off }
  refresh-client -S
}
bind -T suspended F12 {
  set -u prefix
  set -u key-table
  refresh-client -S
}

###
### Local config
###
if-shell "[ -f ~/.tmux.conf.local ]" 'source ~/.tmux.conf.local'

