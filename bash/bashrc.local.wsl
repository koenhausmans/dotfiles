
WSL_SESSION_FILE="${WSL_SESSION_FILE:-/dev/shm/wsl-session}"
SSH_AGENT_FOLDER="${SSH_AGENT_FOLDER:-/dev/shm/ssh-agent}"


# DO NOT CHANGE BELOW


# Source: https://www.reynoldsbd.net/post/wsl-hacks-1/

# Set the DISPLAY environment variable for usage with X server for Windows (eg. Xming)
export DISPLAY=localhost:0.0

# A session marker alone does not prove that the agent is still running.
_dotfiles_wsl_agent_ready() {
    [[ -f "$SSH_AGENT_FOLDER/env" && -S "$SSH_AGENT_FOLDER/agent.sock" ]] || return 1
    SSH_AUTH_SOCK="$SSH_AGENT_FOLDER/agent.sock" ssh-add -l >/dev/null 2>&1 && return 0
    local status=$?
    [[ $status -eq 1 ]] # No keys loaded is still a working agent.
}

_dotfiles_wsl_agent_start() {
    mkdir -p "$SSH_AGENT_FOLDER" || return 1
    # Remove only this configuration's old agent socket, never unrelated files.
    rm -f -- "$SSH_AGENT_FOLDER/agent.sock" || return 1
    local env_tmp
    env_tmp=$(mktemp "$SSH_AGENT_FOLDER/env.XXXXXX") || return 1
    if ssh-agent -a "$SSH_AGENT_FOLDER/agent.sock" > "$env_tmp" &&
       [[ -s $env_tmp && -S "$SSH_AGENT_FOLDER/agent.sock" ]]; then
        mv -- "$env_tmp" "$SSH_AGENT_FOLDER/env" || return 1
        touch "$WSL_SESSION_FILE"
    else
        rm -f -- "$env_tmp"
        return 1
    fi
}

if ! _dotfiles_wsl_agent_ready; then
    rm -f -- "$WSL_SESSION_FILE"
    if ! _dotfiles_wsl_agent_start; then
        printf 'Could not start WSL ssh-agent\n' >&2
    fi
else
    touch "$WSL_SESSION_FILE"
fi

if _dotfiles_wsl_agent_ready; then
    . "$SSH_AGENT_FOLDER/env" > /dev/null
fi
unset -f _dotfiles_wsl_agent_ready _dotfiles_wsl_agent_start
