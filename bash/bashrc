### ---------------------------------------------------------------------------
### General
### ---------------------------------------------------------------------------

# Source bash aliases
if [ -f ~/.bash_aliases ]; then
    . ~/.bash_aliases
fi

# Source global definitions
if [ -f /etc/bashrc ]; then
    . /etc/bashrc
fi

# If not running interactively, don't do anything
case $- in
    *i*) ;;
      *) return;;
esac

shopt -s checkwinsize

set -o emacs

# make less more friendly for non-text input files, see lesspipe(1)
[ -x /usr/bin/lesspipe ] && eval "$(SHELL=/bin/sh lesspipe)"

### ---------------------------------------------------------------------------
### Auto completion
### ---------------------------------------------------------------------------
shopt -s dotglob 2>/dev/null
shopt -s extglob 2>/dev/null
shopt -s globstar 2>/dev/null
shopt -s hostcomplete 2>/dev/null
shopt -s nocaseglob 2>/dev/null

# Load bash_completion (including git support)

[[ -f /etc/bash_completion ]] && . /etc/bash_completion
[[ -f /etc/bash_completion.d/git ]] && . /etc/bash_completion.d/git
[[ -f /usr/share/bash-completion/bash_completion ]] && . /usr/share/bash-completion/bash_completion

### ---------------------------------------------------------------------------
### Environment variables
### ---------------------------------------------------------------------------

if [[ $TERM == xterm ]] ; then
    TERM=xterm-256color
fi

# Find the repository through this file's symlink, so the repository can live anywhere.
__dotfiles=$(cd -- "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")/.." && pwd)

export PATH="$HOME/bin:$__dotfiles/bin:$HOME/.local/bin/:$PATH"

if command -v fnm > /dev/null; then
    eval "$(fnm env --use-on-cd --version-file-strategy=recursive --shell bash)"
fi

export VISUAL="vim"
export EDITOR="$VISUAL"

### ---------------------------------------------------------------------------
### Directories
### ---------------------------------------------------------------------------
shopt -s autocd 2>/dev/null
shopt -s cdspell 2>/dev/null
shopt -s cdable_vars 2>/dev/null
shopt -s dirspell 2>/dev/null

# Use normal directory colors for writable/sticky directories, without backgrounds.
if [[ ${LS_COLORS-} != *'ow=01;34:tw=01;34:st=01;34' ]]; then
    export LS_COLORS="${LS_COLORS:+${LS_COLORS}:}ow=01;34:tw=01;34:st=01;34"
fi

alias ls='ls --color=auto'
alias grep='grep --color=auto'
alias ip='ip --color=auto'

### ---------------------------------------------------------------------------
### Aliases
### ---------------------------------------------------------------------------

# Remove shortcuts
alias rr="rm -rf"

# Directory navigation aliases
alias ..="cd .."
alias ...="cd ../.."
alias ....="cd ../../.."
alias .....="cd ../../../.."
alias ......="cd ../../../../.."

alias -- -='cd -'

# Ls aliases
alias lsa='ls -lah'
alias l='ls -lh'
alias ll='ls -lh'
alias la='ls -lAh'

# Git alias
alias ga='git add'
alias gc='git commit'
alias gca='git commit -a'
alias gcam='git commit -a -m'
alias gcm='git commit -m'
alias gd='git diff'
alias gdc='git diff --cached'
alias gdt='git diff-tree --no-commit-id --name-only -r'
alias gl='git log --stat'
alias gpush='git push'
alias gpull='git pull --rebase'
alias gs='git status -sb'

# Output the week number
alias week="date +%V"

### ---------------------------------------------------------------------------
### Customization
### ---------------------------------------------------------------------------

[[ -f "$__dotfiles/bash/git_prompt.bash" ]] && . "$__dotfiles/bash/git_prompt.bash"
unset __dotfiles

function _prompt_command {
    local _exit_status="$?"

    local _red="\[\e[01;31m\]"
    local _yellow="\[\e[01;33m\]"
    local _blue="\[\e[01;34m\]"
    local _rst="\[\e[0m\]"

    local _HOST=''
    [[ -n "$SSH_CONNECTION" ]] && _HOST="$_yellow\u@\h "
    _git_prompt

    PS1="$_HOST$_blue\w "
    if [[ -n $__dotfiles_git_branch ]]; then
        PS1+="$_rst(${__dotfiles_git_color}"
        PS1+='${__dotfiles_git_branch}'
        PS1+="$_rst${__dotfiles_git_flags}) "
    fi

    if [[ $_exit_status != 0 ]] ; then
        PS1+="${_red}\$${_rst} "
    else
        PS1+="${_blue}\$${_rst} "
    fi
    return "$_exit_status"
}

_dotfiles_register_prompt_command() {
    local declaration
    local -a existing_hooks
    declaration=$(declare -p PROMPT_COMMAND 2>/dev/null) || declaration=''
    # z.sh appends to PROMPT_COMMAND as a string, so preserve array hooks as
    # separate commands in a scalar before sourcing it.
    if [[ $declaration == 'declare -a'* ]]; then
        existing_hooks=("${PROMPT_COMMAND[@]}")
        unset PROMPT_COMMAND
        if ((${#existing_hooks[@]})); then
            printf -v PROMPT_COMMAND '%s\n' "${existing_hooks[@]}"
        fi
    fi

    case $'\n'$PROMPT_COMMAND$'\n' in
        *$'\n'_prompt_command$'\n'*) return 0 ;;
    esac
    if [[ -n $PROMPT_COMMAND ]]; then
        PROMPT_COMMAND="_prompt_command"$'\n'"$PROMPT_COMMAND"
    else
        PROMPT_COMMAND=_prompt_command
    fi
}
_dotfiles_register_prompt_command

### ---------------------------------------------------------------------------
### History
### ---------------------------------------------------------------------------

set -o histexpand

shopt -s cmdhist
shopt -s histappend

HISTCONTROL=ignoreboth
HISTSIZE=1000
HISTFILESIZE=2000

### ---------------------------------------------------------------------------
### FZF Plugin
### ---------------------------------------------------------------------------

# fzf ignores --tmux outside tmux; its Vim plugin drops it when fzf opens in a Vim window.
export FZF_DEFAULT_OPTS="--tmux bottom,40%"
if [[ -z ${FZF_CTRL_T_OPTS+x} ]] && { command -v bat > /dev/null || command -v batcat > /dev/null; }; then
    export FZF_CTRL_T_OPTS="--preview 'fzf-file-preview {}'"
fi
if [[ $- == *i* ]] && command -v fzf > /dev/null; then
    eval "$(fzf --bash)"
fi

### ---------------------------------------------------------------------------
### Z Plugin
### ---------------------------------------------------------------------------
load_z() {
    local Z_HOME="$HOME/.local/share/z/"
    [[ -f "$Z_HOME/z.sh" ]] && . "$Z_HOME/z.sh"
}
load_z

### ---------------------------------------------------------------------------
### Load machine-specific config files
### ---------------------------------------------------------------------------

# Customize to your needs...
if [[ -f $HOME/.bashrc.local ]]; then
    source "$HOME/.bashrc.local"
fi
