#!/bin/sh
# Source: https://github.com/tpope/dotfiles/blob/master/.git_template/hooks/ctags
# See also: https://tbaggery.com/2011/08/08/effortless-ctags-with-git.html
set -e

if [ "$(git rev-parse --git-dir)" = "$(git rev-parse --git-common-dir)" ]; then
  out="$(git rev-parse --absolute-git-dir)/tags"
else
  # Worktrees have a .git file, so Vim cannot find .git/tags there.
  out="$(git rev-parse --show-toplevel)/.tags"
fi

trap 'rm -f "$out.$$"' EXIT INT TERM
git ls-files | ctags --tag-relative=always -L - -f "$out.$$"
mv "$out.$$" "$out"
