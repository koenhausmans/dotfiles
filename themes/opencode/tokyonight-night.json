{
  "$schema": "https://opencode.ai/theme.json",
  "base": {
    "categorical": [
      "accent",
      "blue",
      "green",
      "purple",
      "orange",
      "red"
    ],
    "text": {
      "base": "#c0caf5",
      "muted": "$hue.neutral.300",
      "action": {
        "primary": {
          "base": "$text.base",
          "$disabled": "$hue.neutral.400",
          "$focused": "$hue.neutral.900",
          "$selected": "$hue.interactive.200"
        },
        "secondary": {
          "base": "$text.muted",
          "$hovered": "$text.base"
        },
        "destructive": {
          "base": "$hue.neutral.900",
          "$disabled": "$hue.neutral.400"
        }
      },
      "formfield": {
        "base": "$hue.neutral.200",
        "$hovered": "$hue.interactive.200",
        "$focused": "$hue.interactive.200",
        "$pressed": "$hue.interactive.200",
        "$disabled": "$hue.neutral.400",
        "$selected": "$hue.interactive.200"
      },
      "feedback": {
        "error": {
          "base": "$hue.red.200"
        },
        "warning": {
          "base": "$hue.yellow.200"
        },
        "success": {
          "base": "$hue.green.200"
        },
        "info": {
          "base": "$hue.cyan.200"
        }
      }
    },
    "background": {
      "base": "#1a1b26",
      "raised": {
        "base": "$hue.neutral.700",
        "high": "$hue.neutral.600",
        "max": "$hue.neutral.500"
      },
      "action": {
        "primary": {
          "base": "transparent",
          "$hovered": "$hue.neutral.700",
          "$focused": "$hue.interactive.200",
          "$selected": "transparent"
        },
        "secondary": {
          "base": "transparent"
        },
        "destructive": {
          "base": "$hue.red.200"
        }
      },
      "formfield": {
        "base": "$background.base"
      },
      "feedback": {
        "error": {
          "base": "$background.base"
        },
        "warning": {
          "base": "$background.base"
        },
        "success": {
          "base": "$background.base"
        },
        "info": {
          "base": "$background.base"
        }
      }
    },
    "border": {
      "base": "$hue.neutral.500"
    },
    "scrollbar": {
      "base": "$hue.neutral.400"
    },
    "diff": {
      "text": {
        "added": "$hue.green.200",
        "removed": "$hue.red.200",
        "context": "$text.muted",
        "hunkHeader": "$hue.blue.200"
      },
      "background": {
        "added": "$hue.green.900",
        "removed": "$hue.red.900",
        "context": "$background.raised.base"
      },
      "highlight": {
        "added": "$hue.green.100",
        "removed": "$hue.red.100"
      },
      "lineNumber": {
        "text": "$text.muted",
        "background": {
          "added": "$hue.green.800",
          "removed": "$hue.red.800"
        }
      }
    },
    "syntax": {
      "comment": "$text.muted",
      "keyword": "$hue.purple.200",
      "function": "$hue.blue.200",
      "variable": "$text.base",
      "string": "$hue.green.200",
      "number": "$hue.orange.200",
      "type": "$hue.yellow.200",
      "operator": "$hue.cyan.200",
      "punctuation": "$text.base"
    },
    "markdown": {
      "text": "$text.base",
      "heading": "$hue.accent.200",
      "link": "$hue.blue.200",
      "linkText": "$hue.cyan.200",
      "code": "$hue.green.200",
      "blockQuote": "$text.muted",
      "emphasis": "$hue.yellow.200",
      "strong": "$hue.orange.200",
      "horizontalRule": "$text.muted",
      "listItem": "$hue.accent.200",
      "listEnumeration": "$hue.cyan.200",
      "image": "$hue.blue.200",
      "imageText": "$hue.cyan.200",
      "codeBlock": "$text.base"
    },
    "@dialog": {
      "background": {
        "base": "$background.raised.base",
        "action": {
          "primary": {
            "$hovered": "$background.raised.high"
          }
        }
      }
    }
  },
  "dark": {
    "hue": {
      "gray": {
        "100": "#c9d2f6",
        "200": "#c0caf5",
        "300": "#a9b1d6",
        "400": "#60647d",
        "500": "#4c5064",
        "600": "#3b3e4f",
        "700": "#2e303f",
        "800": "#1a1b26",
        "900": "#101118"
      },
      "red": {
        "100": "#ef99b3",
        "200": "#ff899d",
        "300": "#f7768e",
        "400": "#cb6479",
        "500": "#9f5264",
        "600": "#774152",
        "700": "#583443",
        "800": "#3d2a37",
        "900": "#29212d"
      },
      "orange": {
        "100": "#eeab95",
        "200": "#fda175",
        "300": "#ec917c",
        "400": "#c2796b",
        "500": "#98625a",
        "600": "#724d4a",
        "700": "#553c3e",
        "800": "#3c2e34",
        "900": "#29232c"
      },
      "yellow": {
        "100": "#ecbe75",
        "200": "#faba4a",
        "300": "#e0af68",
        "400": "#b8915b",
        "500": "#91744e",
        "600": "#6d5942",
        "700": "#514438",
        "800": "#3a3331",
        "900": "#28252b"
      },
      "green": {
        "100": "#a7da70",
        "200": "#9fe044",
        "300": "#9ece6a",
        "400": "#84aa5c",
        "500": "#69864f",
        "600": "#516643",
        "700": "#3f4d39",
        "800": "#2f3831",
        "900": "#23282b"
      },
      "cyan": {
        "100": "#abd6fc",
        "200": "#a4daff",
        "300": "#7dcfff",
        "400": "#69abd4",
        "500": "#5587a8",
        "600": "#446781",
        "700": "#364d63",
        "800": "#2a3849",
        "900": "#212835"
      },
      "blue": {
        "100": "#9ab6fc",
        "200": "#8db0ff",
        "300": "#7aa2f7",
        "400": "#6787cd",
        "500": "#546ca3",
        "600": "#42547e",
        "700": "#354161",
        "800": "#293147",
        "900": "#212435"
      },
      "purple": {
        "100": "#c5b1fc",
        "200": "#c7a9ff",
        "300": "#bb9af7",
        "400": "#9b81cd",
        "500": "#7b67a3",
        "600": "#5e507e",
        "700": "#473f61",
        "800": "#342f47",
        "900": "#252435"
      },
      "accent": "$hue.purple",
      "interactive": "$hue.blue",
      "neutral": "$hue.gray"
    }
  }
}
