{
  "$schema": "https://opencode.ai/theme.json",
  "base": {
    "categorical": [
      "accent",
      "blue",
      "green",
      "purple",
      "orange",
      "red"
    ],
    "text": {
      "base": "#ebdbb2",
      "muted": "$hue.neutral.300",
      "action": {
        "primary": {
          "base": "$text.base",
          "$disabled": "$hue.neutral.400",
          "$focused": "$hue.neutral.900",
          "$selected": "$hue.interactive.200"
        },
        "secondary": {
          "base": "$text.muted",
          "$hovered": "$text.base"
        },
        "destructive": {
          "base": "$hue.neutral.900",
          "$disabled": "$hue.neutral.400"
        }
      },
      "formfield": {
        "base": "$hue.neutral.200",
        "$hovered": "$hue.interactive.200",
        "$focused": "$hue.interactive.200",
        "$pressed": "$hue.interactive.200",
        "$disabled": "$hue.neutral.400",
        "$selected": "$hue.interactive.200"
      },
      "feedback": {
        "error": {
          "base": "$hue.red.200"
        },
        "warning": {
          "base": "$hue.yellow.200"
        },
        "success": {
          "base": "$hue.green.200"
        },
        "info": {
          "base": "$hue.cyan.200"
        }
      }
    },
    "background": {
      "base": "#282828",
      "raised": {
        "base": "$hue.neutral.700",
        "high": "$hue.neutral.600",
        "max": "$hue.neutral.500"
      },
      "action": {
        "primary": {
          "base": "transparent",
          "$hovered": "$hue.neutral.700",
          "$focused": "$hue.interactive.200",
          "$selected": "transparent"
        },
        "secondary": {
          "base": "transparent"
        },
        "destructive": {
          "base": "$hue.red.200"
        }
      },
      "formfield": {
        "base": "$background.base"
      },
      "feedback": {
        "error": {
          "base": "$background.base"
        },
        "warning": {
          "base": "$background.base"
        },
        "success": {
          "base": "$background.base"
        },
        "info": {
          "base": "$background.base"
        }
      }
    },
    "border": {
      "base": "$hue.neutral.500"
    },
    "scrollbar": {
      "base": "$hue.neutral.400"
    },
    "diff": {
      "text": {
        "added": "$hue.green.200",
        "removed": "$hue.red.200",
        "context": "$text.muted",
        "hunkHeader": "$hue.blue.200"
      },
      "background": {
        "added": "$hue.green.900",
        "removed": "$hue.red.900",
        "context": "$background.raised.base"
      },
      "highlight": {
        "added": "$hue.green.100",
        "removed": "$hue.red.100"
      },
      "lineNumber": {
        "text": "$text.muted",
        "background": {
          "added": "$hue.green.800",
          "removed": "$hue.red.800"
        }
      }
    },
    "syntax": {
      "comment": "$text.muted",
      "keyword": "$hue.purple.200",
      "function": "$hue.blue.200",
      "variable": "$text.base",
      "string": "$hue.green.200",
      "number": "$hue.orange.200",
      "type": "$hue.yellow.200",
      "operator": "$hue.cyan.200",
      "punctuation": "$text.base"
    },
    "markdown": {
      "text": "$text.base",
      "heading": "$hue.accent.200",
      "link": "$hue.blue.200",
      "linkText": "$hue.cyan.200",
      "code": "$hue.green.200",
      "blockQuote": "$text.muted",
      "emphasis": "$hue.yellow.200",
      "strong": "$hue.orange.200",
      "horizontalRule": "$text.muted",
      "listItem": "$hue.accent.200",
      "listEnumeration": "$hue.cyan.200",
      "image": "$hue.blue.200",
      "imageText": "$hue.cyan.200",
      "codeBlock": "$text.base"
    },
    "@dialog": {
      "background": {
        "base": "$background.raised.base",
        "action": {
          "primary": {
            "$hovered": "$background.raised.high"
          }
        }
      }
    }
  },
  "dark": {
    "hue": {
      "gray": {
        "100": "#eee0be",
        "200": "#ebdbb2",
        "300": "#a89984",
        "400": "#928374",
        "500": "#625e51",
        "600": "#4f4c44",
        "700": "#3f3d39",
        "800": "#282828",
        "900": "#191919"
      },
      "red": {
        "100": "#f76e54",
        "200": "#fb4934",
        "300": "#cc241d",
        "400": "#ab251f",
        "500": "#8a2621",
        "600": "#6d2623",
        "700": "#562725",
        "800": "#422726",
        "900": "#332827"
      },
      "orange": {
        "100": "#f79852",
        "200": "#fb8132",
        "300": "#d15c1f",
        "400": "#af5221",
        "500": "#8d4723",
        "600": "#6f3e24",
        "700": "#573725",
        "800": "#433027",
        "900": "#342c27"
      },
      "yellow": {
        "100": "#f6c450",
        "200": "#fabd2f",
        "300": "#d79921",
        "400": "#b48222",
        "500": "#916c24",
        "600": "#725725",
        "700": "#594826",
        "800": "#443a27",
        "900": "#343028"
      },
      "green": {
        "100": "#c5c349",
        "200": "#b8bb26",
        "300": "#98971a",
        "400": "#82811d",
        "500": "#6b6b20",
        "600": "#575722",
        "700": "#474724",
        "800": "#3a3a26",
        "900": "#303027"
      },
      "cyan": {
        "100": "#a5c78a",
        "200": "#8ec07c",
        "300": "#689d6a",
        "400": "#5b865d",
        "500": "#4e6e50",
        "600": "#435944",
        "700": "#3a493a",
        "800": "#323b33",
        "900": "#2c302d"
      },
      "blue": {
        "100": "#9db29e",
        "200": "#83a598",
        "300": "#458588",
        "400": "#3f7275",
        "500": "#396062",
        "600": "#344f50",
        "700": "#304243",
        "800": "#2d3737",
        "900": "#2a2f2f"
      },
      "purple": {
        "100": "#d99ba1",
        "200": "#d3869b",
        "300": "#b16286",
        "400": "#965673",
        "500": "#7a4b60",
        "600": "#62404f",
        "700": "#4e3842",
        "800": "#3e3137",
        "900": "#322c2f"
      },
      "accent": "$hue.yellow",
      "interactive": "$hue.blue",
      "neutral": "$hue.gray"
    }
  }
}
